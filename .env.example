DATABASE_URL=postgresql://app:change-me@localhost:5432/customer_support
JWT_SECRET=replace-with-at-least-32-random-characters
SUPPORT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# Development-only example (32 zero bytes). Generate a unique key for every deployment.
SUPPORT_DATA_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
CORS_ORIGINS=http://localhost:5173
PORT=5001
SUPPORT_MIN_CORRECTNESS=0.9
SUPPORT_MIN_EDGE_CASE_RECALL=0.9
SUPPORT_MAX_LATENCY_MS=2000
SUPPORT_MIN_RESOLUTION_RATE=0.8
SUPPORT_MAX_GROUP_DELTA=0.1
