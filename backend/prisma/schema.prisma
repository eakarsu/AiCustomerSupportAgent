generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("agent")
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets              Ticket[]
  messages             Message[]
  responses            CannedResponse[]
  knowledgeBase        KnowledgeArticle[]
  emailVerifications   EmailVerification[]
}

model Customer {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  phone       String?
  company     String?
  avatar      String?
  notes       String?
  tier        String   @default("standard")
  totalSpent  Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets     Ticket[]
  messages    Message[]
  calls       Call[]
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  color       String   @default("#6366f1")
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets          Ticket[]
  knowledgeArticles KnowledgeArticle[]
}

model Ticket {
  id          String   @id @default(uuid())
  subject     String
  description String
  status      String   @default("open")
  priority    String   @default("medium")
  source      String   @default("web")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?

  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])

  assigneeId  String?
  assignee    User?    @relation(fields: [assigneeId], references: [id])

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  messages    Message[]
  tags        TicketTag[]
  calls       Call[]

  // AI feature relations
  classifications       AiTicketClassification[]
  resolutionPredictions AiResolutionPrediction[]
  knowledgeSuggestions  AiKnowledgeSuggestion[]
  qualityScores         AiQualityScore[]
  escalationRoutings    AiEscalationRouting[]
}

model Message {
  id          String   @id @default(uuid())
  content     String
  isFromAgent Boolean  @default(false)
  isAiGenerated Boolean @default(false)
  sentiment   String?
  createdAt   DateTime @default(now())

  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderId    String?
  senderUser  User?    @relation(fields: [senderId], references: [id])

  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
}

model Tag {
  id          String   @id @default(uuid())
  name        String   @unique
  color       String   @default("#3b82f6")
  createdAt   DateTime @default(now())

  tickets     TicketTag[]
}

model TicketTag {
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  tagId       String
  tag         Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
}

model KnowledgeArticle {
  id          String   @id @default(uuid())
  title       String
  content     String
  summary     String?
  views       Int      @default(0)
  helpful     Int      @default(0)
  notHelpful  Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId    String
  author      User     @relation(fields: [authorId], references: [id])

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
}

model CannedResponse {
  id          String   @id @default(uuid())
  title       String
  content     String
  shortcut    String?
  useCount    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
}

model Analytics {
  id                String   @id @default(uuid())
  date              DateTime @default(now())
  totalTickets      Int      @default(0)
  resolvedTickets   Int      @default(0)
  avgResponseTime   Float    @default(0)
  avgResolutionTime Float    @default(0)
  customerSatisfaction Float @default(0)
  aiResolutions     Int      @default(0)
}

model AiConversation {
  id          String   @id @default(uuid())
  sessionId   String
  question    String
  response    String
  intent      String?
  confidence  Float?
  wasHelpful  Boolean?
  createdAt   DateTime @default(now())
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Call {
  id              String   @id @default(uuid())
  twilioCallSid   String   @unique
  callerPhone     String
  calledPhone     String
  direction       String   @default("inbound")
  status          String   @default("ringing")
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  duration        Int      @default(0)
  recordingUrl    String?
  summary         String?
  sentiment       String?
  wasTransferred  Boolean  @default(false)
  transferredTo   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])

  ticketId        String?
  ticket          Ticket?   @relation(fields: [ticketId], references: [id])

  transcripts     CallTranscript[]
}

model CallTranscript {
  id          String   @id @default(uuid())
  speaker     String
  content     String
  confidence  Float?
  timestamp   DateTime @default(now())

  callId      String
  call        Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
}

// AI Ticket Classification
model AiTicketClassification {
  id              String   @id @default(uuid())
  ticketId        String?
  subject         String
  description     String
  suggestedCategory String
  suggestedPriority String
  suggestedTags   String[]
  confidence      Float
  reasoning       String?
  sentiment       String?
  urgencyScore    Int      @default(5)
  createdAt       DateTime @default(now())

  ticket          Ticket?  @relation(fields: [ticketId], references: [id])
}

// AI Resolution Predictions
model AiResolutionPrediction {
  id                    String   @id @default(uuid())
  ticketId              String?
  subject               String
  description           String
  predictedResolution   String
  estimatedTimeHours    Float
  suggestedSteps        String[]
  similarTicketsCount   Int      @default(0)
  confidence            Float
  predictedOutcome      String?
  createdAt             DateTime @default(now())

  ticket                Ticket?  @relation(fields: [ticketId], references: [id])
}

// AI Knowledge Suggestions
model AiKnowledgeSuggestion {
  id                  String   @id @default(uuid())
  query               String
  ticketId            String?
  suggestedArticles   Json
  generatedAnswer     String?
  confidence          Float
  wasHelpful          Boolean?
  createdAt           DateTime @default(now())

  ticket              Ticket?  @relation(fields: [ticketId], references: [id])
}

// AI Quality Scores
model AiQualityScore {
  id                  String   @id @default(uuid())
  ticketId            String?
  responseId          String?
  overallScore        Float
  clarityScore        Float
  helpfulnessScore    Float
  professionalismScore Float
  completenessScore   Float
  feedback            String?
  improvements        String[]
  createdAt           DateTime @default(now())

  ticket              Ticket?  @relation(fields: [ticketId], references: [id])
}

// AI Escalation Routing
model AiEscalationRouting {
  id                  String   @id @default(uuid())
  ticketId            String?
  subject             String
  description         String
  shouldEscalate      Boolean
  escalationReason    String?
  suggestedTeam       String?
  suggestedAgent      String?
  urgencyLevel        String
  customerSentiment   String?
  riskScore           Float
  confidence          Float
  createdAt           DateTime @default(now())

  ticket              Ticket?  @relation(fields: [ticketId], references: [id])
}

// AI Shopping Assistant Conversations
model AiShoppingConversation {
  id              String   @id @default(uuid())
  sessionId       String
  customerMessage String
  assistantResponse String
  intent          String?
  productRecommendations Json?
  cartActions     Json?
  orderInfo       Json?
  confidence      Float?
  createdAt       DateTime @default(now())
}

// E-commerce Products for Shopping Assistant
model Product {
  id              String   @id @default(uuid())
  name            String
  description     String
  price           Float
  category        String
  imageUrl        String?
  stock           Int      @default(0)
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  tags            String[]
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Shopping Cart
model ShoppingCart {
  id          String   @id @default(uuid())
  sessionId   String
  items       Json
  totalAmount Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Password Reset Tokens
model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Email Verification Tokens
model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  email     String
  token     String   @unique
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

// Blacklisted JWT Tokens (for logout)
model BlacklistedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Audit Log
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

// Orders
model Order {
  id              String   @id @default(uuid())
  orderNumber     String   @unique
  sessionId       String?
  customerId      String?
  customerEmail   String
  customerName    String
  items           Json
  totalAmount     Float
  status          String   @default("pending")
  shippingAddress String?
  trackingNumber  String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── CRM Models ───────────────────────────────────────────────────────────────

model CrmContact {
  id              String   @id @default(uuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  title           String?
  department      String?
  accountId       String?
  ownerId         String?
  leadSource      String?
  status          String   @default("active")
  buyerPersona    String?
  engagementScore Float?
  leadFitScore    Float?
  lastActivityAt  DateTime?
  enrichedAt      DateTime?
  isDuplicate     Boolean  @default(false)
  mergedIntoId    String?
  isArchived      Boolean  @default(false)
  archivedAt      DateTime?
  customFields    Json?
  aiSummary       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account         CrmAccount?    @relation(fields: [accountId], references: [id])
  opportunities   CrmOpportunity[]
  activities      CrmActivity[]
  quotes          CrmQuote[]
}

model CrmAccount {
  id                  String   @id @default(uuid())
  name                String
  domain              String?
  industry            String?
  accountTier         String   @default("standard")
  parentAccountId     String?
  billingAddress      String?
  website             String?
  phone               String?
  employeeCount       Int?
  annualRevenue       Float?
  ownerId             String?
  status              String   @default("active")
  strategicScore      Float?
  expansionRevenue    Float?
  churnRisk           Float?
  healthScore         Float?
  isArchived          Boolean  @default(false)
  archivedAt          DateTime?
  customFields        Json?
  aiSummary           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  parentAccount       CrmAccount?    @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts       CrmAccount[]   @relation("AccountHierarchy")
  contacts            CrmContact[]
  opportunities       CrmOpportunity[]
  activities          CrmActivity[]
  quotes              CrmQuote[]
}

model CrmPipelineStage {
  id              String   @id @default(uuid())
  name            String
  order           Int
  probability     Float    @default(0)
  pipelineId      String?
  entryConditions String?
  exitConditions  String?
  automationRules String?
  isActive        Boolean  @default(true)
  isArchived      Boolean  @default(false)
  archivedAt      DateTime?
  aiSummary       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  opportunities   CrmOpportunity[]
}

model CrmOpportunity {
  id              String   @id @default(uuid())
  name            String
  accountId       String?
  contactId       String?
  stageId         String?
  ownerId         String?
  amount          Float?
  closeDate       DateTime?
  probability     Float?
  forecastCategory String  @default("pipeline")
  type            String?
  leadSource      String?
  nextStep        String?
  lossReason      String?
  winProbScore    Float?
  dealRiskScore   Float?
  isStalled       Boolean  @default(false)
  isSingleThread  Boolean  @default(false)
  isArchived      Boolean  @default(false)
  archivedAt      DateTime?
  customFields    Json?
  aiSummary       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account         CrmAccount?       @relation(fields: [accountId], references: [id])
  contact         CrmContact?       @relation(fields: [contactId], references: [id])
  stage           CrmPipelineStage? @relation(fields: [stageId], references: [id])
  activities      CrmActivity[]
  quotes          CrmQuote[]
}

model CrmActivity {
  id              String   @id @default(uuid())
  type            String
  subject         String
  description     String?
  status          String   @default("open")
  dueAt           DateTime?
  completedAt     DateTime?
  duration        Int?
  outcome         String?
  contactId       String?
  accountId       String?
  opportunityId   String?
  ownerId         String?
  engagementQuality Float?
  sentiment       String?
  isCoachingMoment Boolean @default(false)
  isArchived      Boolean  @default(false)
  archivedAt      DateTime?
  customFields    Json?
  aiSummary       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contact         CrmContact?     @relation(fields: [contactId], references: [id])
  account         CrmAccount?     @relation(fields: [accountId], references: [id])
  opportunity     CrmOpportunity? @relation(fields: [opportunityId], references: [id])
}

model CrmEmailSync {
  id              String   @id @default(uuid())
  messageId       String   @unique
  threadId        String?
  subject         String?
  fromAddress     String?
  toAddresses     String[]
  ccAddresses     String[]
  body            String?
  direction       String   @default("inbound")
  status          String   @default("synced")
  intent          String?
  sentiment       String?
  hasAttachments  Boolean  @default(false)
  attachments     Json?
  bouncedAt       DateTime?
  contactId       String?
  accountId       String?
  opportunityId   String?
  isArchived      Boolean  @default(false)
  archivedAt      DateTime?
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CrmCalendarEvent {
  id              String   @id @default(uuid())
  externalId      String?  @unique
  provider        String   @default("google")
  title           String
  description     String?
  startAt         DateTime
  endAt           DateTime
  timezone        String?
  meetingType     String?
  outcome         String?
  qualityScore    Float?
  attendees       Json?
  contactId       String?
  accountId       String?
  opportunityId   String?
  ownerId         String?
  isDoubleBooked  Boolean  @default(false)
  isArchived      Boolean  @default(false)
  archivedAt      DateTime?
  aiSummary       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CrmQuote {
  id              String   @id @default(uuid())
  quoteNumber     String   @unique
  name            String
  status          String   @default("draft")
  contactId       String?
  accountId       String?
  opportunityId   String?
  ownerId         String?
  lineItems       Json?
  subtotal        Float?
  discount        Float?
  tax             Float?
  total           Float?
  validUntil      DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  sentAt          DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  marginScore     Float?
  acceptanceProbability Float?
  isArchived      Boolean  @default(false)
  archivedAt      DateTime?
  customFields    Json?
  aiSummary       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contact         CrmContact?     @relation(fields: [contactId], references: [id])
  account         CrmAccount?     @relation(fields: [accountId], references: [id])
  opportunity     CrmOpportunity? @relation(fields: [opportunityId], references: [id])
}

model CrmForecast {
  id                  String   @id @default(uuid())
  period              String
  periodStart         DateTime
  periodEnd           DateTime
  ownerId             String?
  teamId              String?
  commitAmount        Float?
  bestCaseAmount      Float?
  pipelineAmount      Float?
  closedAmount        Float?
  quotaAmount         Float?
  attainmentPct       Float?
  forecastAccuracy    Float?
  isSandbagged        Boolean  @default(false)
  waterfallData       Json?
  aiNarrative         String?
  isArchived          Boolean  @default(false)
  archivedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
